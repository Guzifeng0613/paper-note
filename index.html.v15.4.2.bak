<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#ECEAE2">
<title>纸片 · 便签</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="stylesheet" href="https://miaoda.feishu.cn/fonts/css2?family=Noto+Sans+SC:wght@300;400;500;700;900&family=Noto+Serif+SC:wght@600;700&family=Manrope:wght@500;600;700;800&display=swap">
<style>
/* ============ 设计变量（浅色） ============ */
:root{
  --font-base:system-ui,-apple-system,"Manrope","Noto Sans SC",sans-serif;
  --paper:#E9EAF4; --paper-card:#F4F5FB;
  --ink:#3B4454; --ink-2:#6C7686; --ink-3:#9AA3B2;
  --line:rgba(110,122,150,.13);
  --soft-bg:rgba(120,132,162,.1);
  --bar-track:rgba(120,132,162,.16);
  --pine:#D29E14; --pine-d:#B8890F; --pine-soft:#F6EACB;
  --hi:#FFE27A;
  --danger:#CC4B43;
  --dk:rgba(148,156,198,.42);
  --sh-out:7px 7px 16px var(--dk),-7px -7px 16px rgba(255,255,255,.92);
  --sh-out-sm:1px 2px 5px var(--dk),-1px -2px 5px rgba(255,255,255,.6);
  --sh-in:inset 4px 4px 9px rgba(146,154,196,.32),inset -4px -4px 9px rgba(255,255,255,.92);
  --shadow:var(--sh-out-sm);
  --shadow-lg:14px 14px 30px rgba(140,150,190,.38),-14px -14px 30px rgba(255,255,255,.85);
  --r-lg:20px; --r-md:14px; --r-sm:10px;
  --safe-b:env(safe-area-inset-bottom,0px);
  --c-yellow:#FFF1BF; --c-pink:#FBD9DE; --c-green:#D3EED2;
  --c-blue:#D3E5F8; --c-purple:#E5DBF8; --c-orange:#FCE2C4; --c-cream:#F7F8FA;
}
/* ============ 深色主题 ============ */
:root[data-theme="dark"]{
  --paper:#1A1C20; --paper-card:#24272D;
  --ink:#E8EAED; --ink-2:#A3A9B2; --ink-3:#6E757E;
  --line:rgba(255,255,255,.09);
  --soft-bg:rgba(255,255,255,.10);
  --bar-track:rgba(255,255,255,.16);
  --pine:#E0AC38; --pine-d:#ECC25A; --pine-soft:rgba(224,172,56,.16);
  --hi:#E0C45C;
  --danger:#E18078;
  --dk:rgba(0,0,0,.5);
  --sh-out:7px 7px 16px rgba(0,0,0,.55),-7px -7px 16px rgba(255,255,255,.05);
  --sh-out-sm:1px 2px 5px rgba(0,0,0,.45);
  --sh-in:inset 4px 4px 9px rgba(0,0,0,.55),inset -4px -4px 9px rgba(255,255,255,.05);
  --shadow:var(--sh-out-sm);
  --shadow-lg:14px 14px 30px rgba(0,0,0,.6),-10px -10px 24px rgba(255,255,255,.04);
  --c-yellow:#574E2C; --c-pink:#5A3740; --c-green:#2F4A37;
  --c-blue:#30445E; --c-purple:#433A5B; --c-orange:#5A412C; --c-cream:#2A2E35;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  font-family:var(--font-base);
  background:#17191D; color:var(--ink);
  display:flex; align-items:center; justify-content:center; overflow:hidden;
}
:root[data-theme="dark"] body{background:#0C0E11}
button{font-family:inherit;border:none;background:none;cursor:pointer;color:inherit}
input,textarea{font-family:inherit;border:none;outline:none;background:none;color:inherit}
ul{list-style:none}
::selection{background:rgba(210,158,20,.30)}
:root[data-theme="dark"] ::selection{background:rgba(224,196,92,.4)}

/* ============ 手机外壳 ============ */
.phone{position:relative;width:100%;height:100%;max-width:430px;background:var(--paper);
  overflow:hidden;display:flex;flex-direction:column}
@media(max-width:519px){body{background:var(--paper);padding:0}}
@media(min-width:520px){
  body{padding:24px}
  .phone{height:min(880px,94vh);border-radius:42px;
    box-shadow:var(--shadow-lg),0 0 0 11px #10130F,0 0 0 13px #333832}
}
.app{position:relative;flex:1;overflow:hidden}
.screen{position:absolute;inset:0;background:var(--paper);display:flex;flex-direction:column;
  transform:none;opacity:0;pointer-events:none;visibility:hidden;
  transition:none;
  overflow:hidden;max-width:100%}
.screen.active{transform:none;opacity:1;pointer-events:auto;visibility:visible;
  transition:none}
.screen.root{transform:none;visibility:visible}
/* 编辑器全屏不透明、主页被完全遮盖：behind 不再做位移（位移会在返回时重建主页合成滚动图层、导致首手势卡顿），class 仅作钩子 */
.screen.root.behind{transform:none;opacity:1}
.screen.hide-instant{transition:none!important;transform:none!important;opacity:0!important;visibility:hidden!important}
.screen-body{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;will-change:scroll-position}

/* ============ 顶栏 ============ */
.topbar{display:flex;align-items:center;gap:10px;
  padding:13px 22px 10px;
  padding-top:max(13px,calc(env(safe-area-inset-top,0px) + 7px));
  flex-shrink:0;min-height:62px}
.icon-btn{width:40px;height:40px;border-radius:50%;flex-shrink:0;display:flex;
  align-items:center;justify-content:center;background:var(--paper-card);
  box-shadow:var(--sh-out-sm);transition:box-shadow .2s,transform .2s}
.icon-btn:active{box-shadow:var(--sh-in);transform:scale(.92)}
.ai-entry{color:var(--pine)}
.ai-entry:active{background:var(--pine-soft)}
.icon-btn svg{width:21px;height:21px}
.topbar h1{font-size:20px;font-weight:800;flex:1}
.brand{font-family:"Noto Serif SC",serif}

/* 首页搜索（真实输入） */
.search-entry{flex:1;height:42px;border-radius:23px;background:var(--paper-card);
  display:flex;align-items:center;justify-content:center;gap:9px;padding:0 14px;box-shadow:var(--sh-out-sm);
  transition:box-shadow .2s}
.search-entry:focus-within{box-shadow:var(--sh-in)}
.search-entry>svg{width:18px;height:18px;flex-shrink:0;color:var(--ink-3)}
.search-entry input{flex:0 1 auto;width:62%;font-size:14.5px;min-width:0}
.search-entry .mini-clear{width:22px;height:22px;border-radius:50%;background:var(--soft-bg);
  align-items:center;justify-content:center;flex-shrink:0}
.search-entry .mini-clear:not([hidden]){display:flex}
.search-entry .mini-clear svg{width:12px;height:12px;color:var(--ink-2)}
.cancel-link{font-size:14.5px;font-weight:700;color:var(--pine);flex-shrink:0;padding:4px 2px;display:none}

/* 分类筛选行 */
.chips-row{display:flex;align-items:center;gap:8px;padding:4px 16px 12px;
  overflow-x:auto;scrollbar-width:none;flex-shrink:0}
.chips-row::-webkit-scrollbar{display:none}
/* 首页头部：下滑自动收起、回滑展开 */
#homeTopbar,#chipsRow{max-height:120px;
  transition:max-height .34s cubic-bezier(.4,0,.2,1),padding .34s cubic-bezier(.4,0,.2,1),
  opacity .26s ease,transform .34s cubic-bezier(.4,0,.2,1)}
#chipsRow{max-height:72px}
#scr-home.head-collapsed #homeTopbar,
#scr-home.head-collapsed #chipsRow{
  max-height:0;opacity:0;padding-top:0;padding-bottom:0;overflow:hidden;
  pointer-events:none;transform:translateY(-10px)}
.nb-filter-btn{flex-shrink:0;display:flex;align-items:center;gap:6px;height:33px;padding:0 13px;
  border-radius:17px;background:var(--soft-bg);color:var(--ink-1);font-size:13.5px;font-weight:700;
  position:sticky;left:0;z-index:2;max-width:150px}
.nb-filter-btn svg{width:16px;height:16px;flex-shrink:0}
.nb-filter-btn span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nb-filter-btn.on{background:var(--pine);color:#fff}
.chip{flex-shrink:0;height:33px;padding:0 15px;border-radius:17px;background:var(--soft-bg);
  color:var(--ink-2);font-size:13.5px;font-weight:600;white-space:nowrap;
  display:flex;align-items:center;gap:5px;transition:all .18s}
.chip .n{font-size:11px;opacity:.7;font-weight:700}
.chip.on{background:var(--ink);color:var(--paper)}
.view-toggle{flex-shrink:0;width:34px;height:34px;border-radius:50%;background:var(--paper-card);
  box-shadow:var(--sh-out-sm);display:flex;align-items:center;justify-content:center}
.view-toggle svg{width:17px;height:17px;color:var(--ink-2)}
.view-toggle.on{background:var(--pine)} .view-toggle.on svg{color:#fff}
.nb-add{flex-shrink:0;width:34px;height:34px;border-radius:50%;background:var(--paper-card);
  box-shadow:var(--sh-out-sm);display:flex;align-items:center;justify-content:center;color:var(--ink-2)}
.nb-add svg{width:17px;height:17px}
.nb-add:active{transform:scale(.86)}

/* ============ 便签网格 / 列表 ============ */
.notes-wrap{padding:2px 16px 110px}
.notes-more{grid-column:1/-1;text-align:center;color:var(--ink-3);font-size:12.5px;padding:16px 0 4px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.grid .note-card{min-height:118px}
.list{display:flex;flex-direction:column;gap:10px;padding:0}
/* ============ AI 对话模块 ============ */
#scr-chat,#noteAiPanel{
  --sh-out:12px 12px 26px rgba(148,156,198,.5),-12px -12px 26px #fff;
  --sh-out-sm:8px 8px 16px rgba(148,156,198,.5),-8px -8px 16px #fff;
  --sh-in:inset 7px 7px 14px rgba(146,154,196,.5),inset -7px -7px 14px #fff}
.scope-bar{display:flex;align-items:center;gap:7px;padding:6px 14px;
  background:transparent;
  font-size:12px;font-weight:600;color:var(--ink-3);line-height:1.3;
  white-space:nowrap;overflow:hidden}
.scope-bar .sb-ico{display:inline-flex;color:var(--pine);flex-shrink:0}
.scope-bar .sb-ico svg{width:15px;height:15px}
.scope-bar .sb-txt{overflow:hidden;text-overflow:ellipsis;animation:sbFade .35s ease both}
@keyframes sbFade{from{opacity:0;transform:translateY(-3px)}to{opacity:1;transform:none}}
.chat-top .chat-title{flex:1;font-size:16px;font-weight:800;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0;padding:0 4px}
.chat-body{padding:14px 16px 12px;display:flex;flex-direction:column;gap:16px}
.chat-empty{margin:auto;text-align:center;padding:0 30px}
.chat-empty .ce-ico{width:60px;height:60px;border-radius:18px;background:var(--pine-soft);color:var(--pine);display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.chat-empty .ce-ico svg{width:30px;height:30px}
.chat-empty h3{font-size:18px;font-weight:800;margin-bottom:8px}
.chat-empty p{font-size:13.5px;color:var(--ink-2);line-height:1.7;margin-bottom:18px}
.ce-sugs{display:flex;flex-direction:column;gap:9px}
.ce-sugs button{border:1.5px solid var(--line);background:var(--paper-card);border-radius:13px;padding:11px 14px;font-size:13.5px;font-weight:600;color:var(--ink-1);text-align:left}
.ce-sugs button:active{background:var(--soft-bg)}
.msg{display:flex;gap:9px;align-items:flex-end}
.msg.user{justify-content:flex-end}
.msg .m-avatar{width:28px;height:28px;border-radius:9px;flex-shrink:0;background:var(--pine-soft);color:var(--pine);display:flex;align-items:center;justify-content:center}
.msg .m-avatar svg{width:17px;height:17px}
.msg .m-bubble{max-width:78%;padding:11px 13px;border-radius:16px;font-size:14.5px;line-height:1.7;word-break:break-word}
.msg.ai .m-bubble{background:none;box-shadow:none;max-width:100%;padding:2px 2px 4px;border-radius:0;color:var(--ink-2)}
.msg.ai .m-bubble b{color:var(--ink)}
.msg.user .m-bubble{max-width:82%;padding:10px 15px;color:#5a4108;
  background:linear-gradient(145deg,#F7D583,#E9B542);border-radius:18px;border-bottom-right-radius:7px;
  box-shadow:0 4px 12px rgba(176,150,90,.35),inset 0 1px 2px rgba(255,255,255,.7)}
.m-bubble p{margin:0 0 8px}.m-bubble p:last-child{margin-bottom:0}
.m-bubble h1,.m-bubble h2,.m-bubble h3{font-size:15.5px;font-weight:800;margin:10px 0 6px;line-height:1.5}
.m-bubble ul,.m-bubble ol{margin:6px 0;padding-left:20px}
.m-bubble li{margin:3px 0}
.m-bubble ul li{position:relative;padding-left:15px}
.m-bubble ul li::before{content:'';position:absolute;left:1px;top:10px;width:6px;height:6px;border-radius:2px;background:var(--pine);box-shadow:0 0 6px rgba(210,158,20,.6)}
.m-bubble code{background:rgba(0,0,0,.08);border-radius:5px;padding:1px 5px;font-size:13px}
.msg.user .m-bubble code{background:rgba(255,255,255,.55);color:#5a4108}
.m-bubble pre{background:rgba(0,0,0,.06);border-radius:10px;padding:10px 12px;overflow-x:auto;margin:8px 0}
.m-bubble blockquote{border-left:3px solid var(--pine);margin:8px 0;padding:2px 0 2px 11px;color:var(--ink-2)}
.m-bubble a{color:var(--pine-d)}
.chat-refs{display:flex;flex-wrap:wrap;gap:9px;margin-top:12px;padding-top:4px}
.cr-ref{display:inline-flex;align-items:center;gap:9px;width:auto;text-align:left;
  padding:6px 13px 6px 6px;border-radius:13px;font-size:13px;font-weight:600;color:var(--ink);line-height:1.3;
  background:var(--paper-card);border:1px solid var(--line);
  box-shadow:0 3px 10px rgba(140,150,180,.25),inset 0 1px 1px rgba(255,255,255,.8);
  transition:transform .2s}
.cr-ico{width:28px;height:28px;border-radius:9px;background:#E4F3E6;color:#3A9E52;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.cr-ico svg{width:16px;height:16px}
.cr-name{max-width:210px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cr-ref:active{transform:scale(.95)}
.typing{display:inline-flex;gap:4px;align-items:center;padding:2px 0}
.typing i{width:6px;height:6px;border-radius:50%;background:var(--ink-3);animation:tdot 1.2s infinite}
.typing i:nth-child(2){animation-delay:.2s}.typing i:nth-child(3){animation-delay:.4s}
@keyframes tdot{0%,60%,100%{opacity:.25;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}
.msg{animation:msgRise .5s cubic-bezier(.34,1.56,.64,1) both}
@keyframes msgRise{from{opacity:0;transform:translateY(14px) scale(.97)}to{opacity:1;transform:none}}
.chat-send{transition:transform .24s cubic-bezier(.34,1.56,.64,1),opacity .2s}.chat-send:active{transform:scale(.88) rotate(-6deg)}
.cd-new:active{transform:scale(.98)}.cd-new{transition:transform .12s}
.chat-input-bar{display:flex;align-items:center;gap:10px;padding:10px 14px calc(12px + var(--safe-b));background:transparent;flex-shrink:0}
.chat-input-wrap{flex:1;background:var(--paper);border-radius:999px;padding:8px 16px;display:flex;align-items:center;box-shadow:var(--sh-in)}
.chat-input-wrap textarea{width:100%;border:0;background:transparent;resize:none;font-size:15px;line-height:1.5;max-height:120px;outline:none;font-family:inherit}
.chat-send{width:44px;height:44px;border-radius:50%;flex-shrink:0;color:#5a4108;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#F4C85E,#D99A22);box-shadow:5px 5px 12px rgba(176,150,90,.5),-5px -5px 12px #fff,inset 0 1px 2px rgba(255,255,255,.7)}
.chat-send:disabled{opacity:.45}
.chat-send svg{width:19px;height:19px}
.chat-drawer-mask{position:fixed;inset:0;background:rgba(20,24,20,.4);z-index:60;opacity:0;pointer-events:none;transition:opacity .25s}
.chat-drawer-mask.open{opacity:1;pointer-events:auto}
.chat-drawer{position:fixed;top:0;left:0;bottom:0;width:78%;max-width:330px;z-index:61;background:var(--paper);
  transform:translateX(-100%);transition:transform .3s cubic-bezier(.32,.72,.24,1);display:flex;flex-direction:column}
.chat-drawer.open{transform:translateX(0)}
.cd-head{display:flex;align-items:center;justify-content:space-between;padding:max(14px,calc(env(safe-area-inset-top,0px) + 8px)) 12px 10px}
.cd-head-sp{width:40px;height:40px;flex-shrink:0}
.cd-head b{flex:1;text-align:center;font-size:16px;font-weight:800}
.cd-new{display:flex;align-items:center;gap:9px;margin:4px 12px 12px;padding:11px 14px;border-radius:14px;background:var(--pine);color:#fff;font-size:14.5px;font-weight:700}
.cd-new svg{width:18px;height:18px}
.cd-list{flex:1;overflow-y:auto;padding:0 8px calc(20px + var(--safe-b))}
.cd-gl{font-size:11px;letter-spacing:1px;font-weight:700;color:var(--ink-3);padding:14px 8px 7px}
.cd-search{display:flex;align-items:center;gap:9px;margin:2px 12px 10px;padding:10px 13px;border-radius:14px;
  background:rgba(255,255,255,.6);border:1px solid rgba(150,160,190,.25);
  box-shadow:inset 3px 3px 7px rgba(146,154,196,.28),inset -3px -3px 7px rgba(255,255,255,.9)}
.cd-search svg{width:15px;height:15px;color:var(--ink-3);flex-shrink:0}
.cd-search input{flex:1;min-width:0;border:0;background:transparent;outline:none;font-size:13.5px;font-family:inherit;color:var(--ink)}
.cd-search input::placeholder{color:var(--ink-3)}
.cd-item{display:flex;align-items:center;gap:8px;width:100%;padding:11px 12px;border-radius:14px;text-align:left;
  background:rgba(255,255,255,.55);border:1px solid rgba(150,160,190,.22);
  box-shadow:0 2px 8px rgba(140,150,180,.18);transition:transform .22s,background .2s,border-color .2s}
.cd-item:active{transform:scale(.97)}
.cd-item.cur{background:rgba(232,178,60,.16);border-color:rgba(210,158,20,.4)}
.cd-item b{flex:1;font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cd-item .cd-del{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--ink-3);flex-shrink:0}
.cd-item .cd-del svg{width:14px;height:14px}
.cd-item .cd-del:active{background:var(--line);color:var(--danger)}
.note-ai-btn{color:var(--pine);font-size:12px;font-weight:800;letter-spacing:.3px}
.note-ai-btn:active{color:var(--pine-d)}
.note-ai-mask{position:fixed;inset:0;background:rgba(20,24,20,.4);z-index:70;opacity:0;pointer-events:none}
.note-ai-mask.open{opacity:1;pointer-events:auto}
.note-ai-panel{position:fixed;left:0;right:0;top:0;bottom:0;z-index:71;background:var(--paper);
  display:none;flex-direction:column}
.note-ai-panel.open{display:flex}
.note-card{position:relative;border-radius:var(--r-lg);padding:14px 14px 12px;
  box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column;
  animation:cardIn .4s cubic-bezier(.32,.72,.24,1) both;transition:transform .15s;touch-action:pan-y;
  user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.note-card:active{transform:scale(.97)}
@keyframes cardIn{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:none}}
/* 首次冷启动后便签墙就绪：之后任何刷新/单卡更新都不再重放入场动画，避免返回主页卡片闪一遍、弱 GPU 掉帧 */
.notes-wrap.ready>.note-card{animation:none!important}
.nc-title{font-size:15px;font-weight:700;line-height:1.35;margin-bottom:5px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;padding-right:20px}
.nc-preview{font-size:13px;line-height:1.55;color:var(--ink-2);display:-webkit-box;
  -webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word;flex:1}
.list .nc-preview{-webkit-line-clamp:2}
.nc-foot{display:flex;align-items:center;justify-content:space-between;margin-top:9px;
  font-size:11px;color:var(--ink-2);font-weight:600}
.todo-progress{display:flex;align-items:center;gap:6px}
.todo-bar{width:46px;height:5px;border-radius:3px;background:var(--bar-track);overflow:hidden}
.todo-bar i{display:block;height:100%;background:var(--pine);border-radius:3px}
.type-ico{display:flex;align-items:center;gap:4px}
.type-ico svg{width:13px;height:13px}
.nc-pin{position:absolute;top:10px;right:10px;width:19px;height:19px;color:var(--pine-d)}
.nc-attach{display:flex;align-items:center;gap:3px}
.nc-attach svg{width:12px;height:12px}

/* 多选勾选圆 */
.sel-circle{position:absolute;top:10px;left:10px;width:23px;height:23px;border-radius:50%;
  border:2px solid var(--ink-3);z-index:6;background:var(--paper);
  display:none;align-items:center;justify-content:center}
.sel-circle svg{width:13px;height:13px;color:#fff;opacity:0}
.select-mode .sel-circle{display:flex}
.select-mode .sel-circle.on{background:var(--pine);border-color:var(--pine)}
.select-mode .sel-circle.on svg{opacity:1}
.select-mode .note-card:active{transform:none}
.select-mode .nc-title{padding-left:28px}
.select-mode .note-card.picked{outline:2.5px solid var(--pine);outline-offset:-1px}
@keyframes pop{0%{transform:scale(.4)}60%{transform:scale(1.18)}100%{transform:scale(1)}}
.select-mode .sel-circle.on svg{opacity:1;animation:pop .24s cubic-bezier(.34,1.56,.64,1)}
/* 通用按压反馈（只用 transform，GPU 合成不掉帧） */
.icon-btn,.chip,.pr-btn,.view-toggle,.bb-btn{transition:transform .13s ease,background .16s,color .16s,border-color .16s}
.icon-btn:active,.chip:active,.pr-btn:active,.view-toggle:active{transform:scale(.86)}
.bb-btn:active{transform:scale(.9)}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;
    transition-duration:.01ms!important}
}

/* 多选上下文顶栏 */
.context-bar{display:none;align-items:center;gap:11px;
  padding:max(13px,calc(env(safe-area-inset-top,0px) + 7px)) 16px 10px;min-height:62px;flex-shrink:0}
.context-bar.show{display:flex}
.context-bar .count{flex:1;font-size:17px;font-weight:800}
.context-bar #selectAll.on{background:var(--pine);color:#fff}
/* 多选底部操作条 */
.batch-bar{position:absolute;left:12px;right:12px;bottom:calc(14px + var(--safe-b));z-index:28;
  background:var(--ink);border-radius:20px;display:none;align-items:center;justify-content:space-around;
  padding:8px 6px;box-shadow:var(--shadow-lg)}
.batch-bar.show{display:flex}
.bb-btn{display:flex;flex-direction:column;align-items:center;gap:3px;color:var(--paper);
  font-size:11px;font-weight:600;padding:4px 8px;border-radius:12px}
.bb-btn svg{width:21px;height:21px}
.bb-btn:active{background:rgba(255,255,255,.12)}

/* ============ FAB ============ */
.fab{position:absolute;right:20px;bottom:calc(24px + var(--safe-b));width:58px;height:58px;
  border-radius:50%;background:var(--pine);display:flex;align-items:center;justify-content:center;
  box-shadow:6px 6px 14px rgba(150,116,18,.42),-5px -5px 12px rgba(255,244,214,.6),
    inset -2px -3px 6px rgba(120,88,8,.28),inset 2px 2px 4px rgba(255,246,224,.55);
  z-index:20;
  transition:transform .22s cubic-bezier(.34,1.56,.64,1),box-shadow .2s}
.fab:active{transform:scale(.92);
  box-shadow:inset 3px 4px 7px rgba(120,88,8,.42),inset -2px -2px 5px rgba(255,246,224,.45)}
.fab svg{width:26px;height:26px;color:#fff}
:root[data-theme="dark"] .fab{box-shadow:6px 6px 14px rgba(0,0,0,.55),-4px -4px 10px rgba(255,220,150,.18),
  inset -2px -3px 6px rgba(0,0,0,.35),inset 2px 2px 4px rgba(255,235,190,.25)}
:root[data-theme="dark"] .fab svg{color:#2E2408}

/* ============ ActionSheet / Modal / Toast ============ */
.mask{position:fixed;inset:0;background:rgba(22,26,22,.42);z-index:130;opacity:0;pointer-events:none;
  transition:opacity .25s}
.mask.show{opacity:1;pointer-events:auto}
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:131;background:var(--paper-card);
  border-radius:26px 26px 0 0;padding:8px 18px calc(20px + var(--safe-b));
  transform:translateY(100%);
  transition:transform .2s cubic-bezier(.3,.8,.3,1)}
.sheet.show{transform:translateY(0)}
.sheet.lift-mid{bottom:auto;top:50%;left:14px;right:14px;border-radius:24px;
  padding-bottom:22px;transform:translateY(-50%);box-shadow:var(--sh-out)}
.sheet-grip{width:38px;height:4px;border-radius:2px;background:var(--soft-bg);margin:6px auto 14px}
.sheet-title{font-size:14px;color:var(--ink-2);font-weight:600;margin:0 4px 12px}
.sheet-opt{width:100%;display:flex;align-items:center;gap:14px;padding:14px 6px;
  border-bottom:1px solid var(--line);font-size:16px;font-weight:600;text-align:left}
.sheet-opt:last-of-type{border-bottom:none}
.opt-ico{width:42px;height:42px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.opt-ico svg{width:21px;height:21px}
.sheet-opt small{display:block;font-size:12px;font-weight:500;color:var(--ink-2);margin-top:2px}
.sheet-cancel{width:100%;margin-top:10px;padding:13px;border-radius:15px;background:var(--soft-bg);font-size:15px;font-weight:700}
.modal{position:absolute;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;
  padding:34px;opacity:0;pointer-events:none;transition:opacity .22s}
.modal.show{opacity:1;pointer-events:auto}
.modal-box{background:var(--paper-card);border-radius:22px;width:100%;max-width:330px;padding:22px;
  box-shadow:var(--shadow-lg);transform:scale(.92);transition:transform .22s cubic-bezier(.34,1.4,.64,1);
  max-height:86%;overflow-y:auto}
.modal.show .modal-box{transform:scale(1)}
.modal-box h3{font-size:17px;font-weight:800;margin-bottom:8px}
.modal-box p{font-size:13.5px;color:var(--ink-2);line-height:1.6;margin-bottom:16px}
.modal-input{width:100%;background:var(--soft-bg);border-radius:13px;height:44px;padding:0 15px;font-size:16px;margin-bottom:16px}
.modal-actions{display:flex;gap:10px}
.fs-ctl{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:18px 0 20px}
.fs-btn{width:64px;height:56px;border-radius:16px;font-size:20px;font-weight:700;color:var(--ink);
  background:var(--paper-card);box-shadow:var(--sh-out-sm)}
.fs-btn:active{transform:scale(.92);box-shadow:var(--sh-in)}
.fs-val{flex:1;text-align:center;font-size:22px;font-weight:700;color:var(--ink)}
.modal-actions button{flex:1;height:44px;border-radius:13px;font-size:14.5px;font-weight:700}
.loc-list{display:flex;flex-direction:column;gap:5px;margin:4px 0 14px}
.loc-list b{font-size:12.5px;color:var(--ink-2);margin-top:7px}
.loc-list code{display:block;font-size:11.5px;background:var(--soft-bg);border-radius:8px;
  padding:7px 10px;font-family:ui-monospace,Menlo,Consolas,monospace;color:var(--ink-2);
  word-break:break-all}
.btn-ghost{background:var(--soft-bg);color:var(--ink)}
.btn-primary{background:var(--pine);color:#fff}
/* 字体选择器 */
.pick-title{font-size:17px;font-weight:800;margin-bottom:14px;text-align:center}
.pick-list{display:flex;flex-direction:column;gap:9px;margin-bottom:14px}
.pick-row{display:flex;align-items:center;gap:10px;width:100%;text-align:left;
  padding:11px 12px;border-radius:14px;border:1.5px solid var(--line);background:var(--paper-card)}
.pick-row.on{border-color:var(--pine)}
.pr-main{flex:1;display:flex;flex-direction:column;gap:2px;min-width:0}
.pr-preview{font-size:18px;font-weight:600;color:var(--ink);line-height:1.45;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pr-name{font-size:14px;font-weight:800}
.pr-main small{font-size:12px;color:var(--ink-3)}
.pr-check{color:var(--pine);display:inline-flex;flex-shrink:0}
.pr-check svg{width:20px;height:20px}
.pick-cancel{width:100%;padding:12px;border-radius:13px;font-size:15px;font-weight:700;
  color:var(--ink-2);background:var(--soft-bg)}
.btn-danger{background:var(--danger);color:#fff}
.toast{position:absolute;left:50%;bottom:110px;transform:translate(-50%,20px);z-index:60;
  background:rgba(30,34,30,.94);color:#fff;font-size:13.5px;font-weight:600;
  padding:11px 16px;border-radius:22px;opacity:0;pointer-events:none;
  transition:opacity .25s,transform .25s;max-width:88%;display:flex;align-items:center;gap:12px}
:root[data-theme="dark"] .toast{background:rgba(232,234,237,.96);color:#1A1C20}
.toast.show{opacity:1;transform:translate(-50%,0);pointer-events:auto}
.toast .t-undo{color:var(--hi);font-weight:800;font-size:13px;flex-shrink:0}
:root[data-theme="dark"] .toast .t-undo{color:#574E1A}

/* ============ 空状态 ============ */
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:64px 40px;text-align:center;color:var(--ink-2)}
.empty svg{width:74px;height:74px;margin-bottom:16px;opacity:.5}
.empty h3{font-size:16px;font-weight:700;margin-bottom:7px;color:var(--ink)}
.empty p{font-size:13.5px;line-height:1.6}
.empty .empty-btn{margin-top:18px;height:42px;padding:0 22px;border-radius:21px;
  background:var(--pine);color:#fff;font-size:14px;font-weight:700;box-shadow:var(--sh-out-sm)}
.empty .empty-btn:active{transform:scale(.95)}

/* ===== v13.445→13.535 交互打磨（10 次迭代） ===== */
/* 按压回弹统一 */
.icon-btn,.nb-filter-btn,.bb-btn,.view-toggle button,.tcp,.cr-ref,.cd-item,.note-card,
.sheet-opt,.sheet-cancel,.cd-new,.pick-row,.chat-send{
  -webkit-tap-highlight-color:transparent;touch-action:manipulation}
.note-card:active{transform:scale(.97)}
.cd-item:active{transform:scale(.96)}
.nb-filter-btn:active,.bb-btn:active,.view-toggle button:active,.sheet-opt:active,
.sheet-cancel:active,.tcp:active,.cr-ref:active,.pick-row:active{transform:scale(.96)}
.icon-btn:active{transform:scale(.86)}
@media(hover:hover){.note-card:hover{transform:translateY(-2px)}}
/* 页面转场顺滑 */
.screen{transition-duration:0s}
/* FAB 滚动联动收起 */
.fab{transition:transform .28s cubic-bezier(.34,1.56,.64,1),box-shadow .2s,opacity .28s}
#scr-home.head-collapsed .fab{transform:scale(.35) translateY(24px);opacity:0;pointer-events:none}
/* toast 弹性入场 */
.toast{transition:opacity .28s,transform .34s cubic-bezier(.34,1.56,.64,1)}
/* 待办勾选 spring（编辑页 .tc 已有 pop 入场，补按压缩放；其他视图 .todo-check 统一 tickPop） */
.pt-row .tc{transition:background .2s,border-color .2s,transform .26s cubic-bezier(.34,1.56,.64,1)}
.pt-row .tc:active{transform:scale(.8)}
.todo-check{transition:background .2s,border-color .2s,transform .28s cubic-bezier(.34,1.56,.64,1)}
.todo-check:active{transform:scale(.8)}
.todo-check svg{transform-origin:center}
.todo-check.done svg{animation:tickPop .36s cubic-bezier(.34,1.56,.64,1)}
@keyframes tickPop{0%{transform:scale(.2)}60%{transform:scale(1.3)}100%{transform:scale(1)}}
.todo-progress-top .bar i{transition:width .45s cubic-bezier(.32,.72,.24,1)}
/* 弹窗/菜单弹性 */
/* sheet 过渡统一在上方 .sheet 主规则定义 */
.modal-box{transition:transform .32s cubic-bezier(.34,1.45,.64,1)}
/* 消息入场 */
.msg{animation:msgIn .36s cubic-bezier(.22,1.05,.36,1) both}
@keyframes msgIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
/* 深色一致性 */
:root[data-theme="dark"] .todo-check{border-color:var(--ink-3)}
/* 尊重减少动画偏好 */
@media(prefers-reduced-motion:reduce){
  .msg,.todo-check.done svg{animation:none!important}
  .note-card,.cd-item,.fab,.icon-btn{transition-duration:.01ms!important}
  .screen{transition-duration:.01ms!important}}
.section-label{font-size:12.5px;font-weight:700;color:var(--ink-3);padding:14px 18px 2px}
.recent-row{display:flex;gap:8px;flex-wrap:wrap;padding:6px 18px}
.recent-pill{font-size:13px;padding:6px 13px;border-radius:15px;background:var(--soft-bg);color:var(--ink-2);font-weight:600}
/* 结果头部（三模式各自配色） */
.sr-res-head{display:flex;align-items:center;gap:10px;padding:4px 3px 12px}
.sr-res-head .rh-ico{width:34px;height:34px;border-radius:11px;display:flex;
  align-items:center;justify-content:center;flex-shrink:0}
.sr-res-head .rh-ico svg{width:19px;height:19px}
.sr-res-head b{font-size:15px;display:block;line-height:1.3}
.sr-res-head span{font-size:12px;color:var(--ink-3)}
.sr-res-head.search .rh-ico{background:rgba(212,160,74,.16);color:#B07A2E}
.sr-res-head.rag .rh-ico{background:rgba(47,107,79,.14);color:var(--pine)}
.sr-res-head.ai .rh-ico{background:rgba(74,107,160,.15);color:#3E609A}
/* 搜索：便签结果行 */
.sr-item{display:flex;align-items:flex-start;gap:11px;width:100%;text-align:left;
  background:var(--paper-card);border:none;border-radius:14px;padding:12px 13px;margin-bottom:9px;
  box-shadow:var(--shadow);cursor:pointer;transition:transform .15s}
.sr-item:active{transform:scale(.98)}
.sr-item .sri-ico{width:30px;height:30px;border-radius:9px;display:flex;
  align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.sr-item .sri-ico svg{width:17px;height:17px}
.sr-item .sri-main{flex:1;min-width:0}
.sr-title{font-size:15px;font-weight:800;color:var(--ink);line-height:1.3;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sr-preview{font-size:13px;color:var(--ink-2);margin-top:2px;line-height:1.45;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sr-meta{display:flex;align-items:center;gap:5px;font-size:11.5px;color:var(--ink-3);margin-top:5px}
.sr-meta svg{width:13px;height:13px;flex:none}
.sr-item .sri-go{color:var(--ink-3);flex-shrink:0;align-self:center}
.sr-item .sri-go svg{width:17px;height:17px}

/* ============ 编辑页 ============ */
.edit-body{flex:1;overflow-y:auto;padding:4px 18px 130px}
.edit-title{width:100%;font-size:23px;font-weight:800;padding:8px 2px 11px;
  border-bottom:2px solid var(--line);margin-bottom:12px;line-height:1.35}
.edit-title::placeholder{color:var(--ink-3)}
.color-row{display:flex;gap:11px;margin-bottom:12px}
.color-dot{width:27px;height:27px;border-radius:50%;border:2px solid transparent;
  box-shadow:inset 0 0 0 1px rgba(127,127,127,.25);flex-shrink:0}
.color-dot.on{border-color:var(--ink)}
.color-dot.on::after{content:"";position:absolute}
/* 插入行（常驻） */
.insert-bar{display:flex;align-items:center;gap:4px;margin-bottom:8px}
.ins-btn{height:34px;padding:0 12px;border-radius:11px;background:var(--soft-bg);
  display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:700;color:var(--ink-2)}
.ins-btn svg{width:16px;height:16px}
.word-count{margin-left:auto;font-size:12px;color:var(--ink-3);font-weight:600}
/* 富文本工具栏（移动：选中才浮现） */
.rt-bar{display:flex;align-items:center;gap:2px;background:var(--paper-card);border-radius:14px;
  padding:0 6px;margin-bottom:0;max-height:0;opacity:0;overflow:hidden;pointer-events:none;
  transition:max-height .25s,opacity .25s,padding .25s;margin-top:0}
.rt-bar.show{padding:6px;margin-bottom:8px;max-height:54px;opacity:1;pointer-events:auto;box-shadow:var(--shadow)}
.rt-btn{width:36px;height:35px;border-radius:10px;display:flex;align-items:center;justify-content:center;
  color:var(--ink-2);font-weight:800;flex-shrink:0}
.rt-btn svg{width:17px;height:17px}
.rt-btn:active,.rt-btn.on{background:var(--ink);color:var(--paper)}
.rt-sep{width:1px;height:19px;background:var(--line);margin:0 4px;flex-shrink:0}
.rt-size{font-size:12px;font-weight:800;min-width:16px;text-align:center;color:var(--ink-2)}
.rt-content{min-height:260px;font-size:15.5px;line-height:1.75;padding:6px 2px;word-break:break-word}
.rt-content:empty::before{content:attr(data-ph);color:var(--ink-3)}
.rt-content b,.rt-content strong{font-weight:800}
.rt-content u{text-decoration:underline;text-underline-offset:3px}
.rt-content .hl{background:var(--hi);border-radius:3px;padding:0 2px}
.rt-content img.note-img{max-width:100%;border-radius:12px;margin:8px 0;display:block;box-shadow:var(--shadow)}
font[size="1"]{font-size:12.5px}font[size="2"]{font-size:14px}font[size="3"]{font-size:15.5px}
font[size="4"]{font-size:17.5px}font[size="5"]{font-size:20px}font[size="6"]{font-size:23px}font[size="7"]{font-size:26px}
@media(min-width:520px){
  .rt-bar{max-height:54px;opacity:1;padding:6px;margin-bottom:8px;pointer-events:auto;box-shadow:var(--shadow)}
}
/* 附件卡片 */
.attach-list{display:flex;flex-direction:column;gap:8px;margin:10px 0 4px}
.attach{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:14px;
  background:var(--soft-bg);width:100%;text-align:left}
.att-ico{width:37px;height:37px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.att-ico svg{width:19px;height:19px;color:#fff}
.att-txt{flex:1;min-width:0}
.att-txt b{display:block;font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.att-txt small{display:block;font-size:11.5px;color:var(--ink-2);margin-top:1px}
.att-del{width:27px;height:27px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--ink-3)}
.att-del svg{width:15px;height:15px}
/* 待办编辑 */
.todo-progress-top{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.todo-progress-top .bar{flex:1;height:8px;border-radius:4px;background:var(--bar-track);overflow:hidden}
.todo-progress-top .bar i{display:block;height:100%;background:var(--pine);transition:width .3s}
.todo-progress-top .pct{font-size:13px;font-weight:700;color:var(--pine);min-width:74px;text-align:right}
.todo-edit-row{display:flex;align-items:center;gap:11px;padding:9px 2px;border-bottom:1px solid var(--line);
  touch-action:none}
.todo-check{width:23px;height:23px;border-radius:50%;border:2px solid var(--ink-3);flex-shrink:0;
  display:flex;align-items:center;justify-content:center;touch-action:manipulation}
.todo-check.done{background:var(--pine);border-color:var(--pine)}
.todo-check svg{width:13px;height:13px;color:#fff;opacity:0}
.todo-check.done svg{opacity:1}
.todo-edit-row input{flex:1;font-size:15px;min-width:0;touch-action:manipulation}
.todo-edit-row input.done{text-decoration:line-through;color:var(--ink-3)}
.todo-pri{width:28px;height:28px;flex-shrink:0;display:flex;align-items:center;justify-content:center;touch-action:manipulation}
.todo-pri svg{width:17px;height:17px}
.todo-del{width:27px;height:27px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--ink-3)}
.todo-del svg{width:16px;height:16px}
.add-todo{display:flex;align-items:center;gap:10px;padding:12px 2px;color:var(--pine);
  font-weight:700;font-size:14.5px;width:100%}
.add-todo svg{width:19px;height:19px}
.todo-edit-row.dragging{opacity:.9}
.todo-edit-row.lift{position:fixed;z-index:15;width:calc(100% - 36px);background:var(--paper-card);
  border-radius:12px;box-shadow:var(--shadow-lg);border-bottom:none}
.todo-ghost{background:var(--pine-soft);border-radius:10px;border-bottom:none}
.save-state{font-size:12px;color:var(--ink-3);font-weight:600;display:flex;align-items:center;gap:4px;flex:1}
.save-state svg{width:13px;height:13px}
.edit-pin{flex-shrink:0}

/* ============ 回收站 ============ */
.trash-row{display:flex;align-items:center;gap:11px;padding:12px 4px;border-bottom:1px solid var(--line)}
.trash-row .t-main{flex:1;min-width:0}
.trash-row .t-main b{display:block;font-size:14.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.trash-row .t-main small{display:block;font-size:12px;color:var(--ink-2);margin-top:2px}
.trash-restore{width:34px;height:34px;border-radius:10px;background:var(--pine-soft);
  display:flex;align-items:center;justify-content:center;flex-shrink:0}
.trash-restore svg{width:17px;height:17px;color:var(--pine-d)}
.trash-forever{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;
  justify-content:center;flex-shrink:0;color:var(--danger)}
.trash-forever svg{width:17px;height:17px}
.trash-list{padding:0 16px}

/* ============ 设置 ============ */
.settings{padding:2px 16px 50px}
.set-card{background:var(--paper-card);border-radius:var(--r-lg);box-shadow:var(--shadow);
  overflow:hidden;margin-bottom:16px}
/* 外观卡片：两组选择器在卡片内上下左右对称居中 */
.set-card.appearance{padding:10px}
.set-card.appearance .seg{margin:0}
.set-card.appearance #viewSeg{margin:8px 0 0}
.ocr-status{padding:12px 16px 4px}
.ocr-st-tip{font-size:13px;color:var(--ink-3)}
.ocr-st-grid{display:flex;gap:10px;flex-wrap:wrap}
.ocr-st-grid>div{flex:1;min-width:60px;background:var(--paper);border-radius:10px;padding:8px 6px;text-align:center}
.ocr-st-grid span{display:block;font-size:11px;color:var(--ink-3)}
.ocr-st-grid b{font-size:18px;font-weight:700}
.ocr-st-grid .fail b{color:#d0564b}
.ocr-st-prog{height:5px;border-radius:3px;background:var(--line);margin-top:10px;overflow:hidden}
.ocr-st-prog i{display:block;height:100%;background:var(--pine);transition:width .3s}
.set-card-h{font-size:13px;font-weight:700;color:var(--ink-3);padding:16px 16px 4px}
.set-row{display:flex;align-items:center;gap:13px;padding:14px 16px;width:100%;text-align:left;
  border-bottom:1px solid var(--line)}
.set-row:last-child{border-bottom:none}
.s-ico{width:36px;height:36px;border-radius:11px;background:var(--pine-soft);
  display:flex;align-items:center;justify-content:center;flex-shrink:0}
.s-ico svg{width:19px;height:19px;color:var(--pine-d)}
.s-txt{flex:1;min-width:0}
.s-txt b{display:block;font-size:14.5px;font-weight:700}
.s-txt small{display:block;font-size:12px;color:var(--ink-2);margin-top:2px;line-height:1.4}
.chev{color:var(--ink-3);flex-shrink:0} .chev svg{width:18px;height:18px}
.switch{width:46px;height:28px;border-radius:14px;background:var(--bar-track);position:relative;flex-shrink:0;transition:background .2s}
.switch i{position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;
  box-shadow:0 2px 5px rgba(0,0,0,.25);transition:transform .2s}
.switch.on{background:var(--pine)} .switch.on i{transform:translateX(18px)}
/* 主题分段 */
.seg{display:flex;background:var(--soft-bg);border-radius:13px;padding:3px;gap:2px;margin:0 16px 14px}
.seg button{flex:1;height:36px;border-radius:10px;font-size:13px;font-weight:700;color:var(--ink-2);
  display:flex;align-items:center;justify-content:center;gap:6px}
.seg button svg{width:15px;height:15px}
.seg button.on{background:var(--paper-card);color:var(--ink);box-shadow:var(--shadow)}
.about-txt{padding:4px 16px 16px;font-size:12.5px;color:var(--ink-2);line-height:1.7}
/* ============ 百度网盘授权 ============ */
.pan-settings{padding:2px 16px 50px}
.pan-state{border-radius:var(--r-lg);padding:16px 18px;margin-bottom:16px;
  display:flex;flex-direction:column;gap:5px;background:var(--paper-card);box-shadow:var(--shadow)}
.pan-state b{font-size:15.5px;font-weight:800;display:flex;align-items:center;gap:9px}
.pan-state b::before{content:"";width:11px;height:11px;border-radius:50%;background:var(--ink-3);flex-shrink:0}
.pan-state>span{font-size:12.5px;color:var(--ink-2);line-height:1.55}
.pan-state.ok{background:var(--pine-soft)}
.pan-state.ok b,.pan-state.ok span{color:var(--pine-d)}
.pan-state.ok b::before{background:var(--pine)}
.pan-state.wait b::before{background:#DFA62B}
.pan-form .pf-row{display:flex;flex-direction:column;gap:6px;padding:12px 16px;border-bottom:1px solid var(--line)}
.pan-form .pf-row>span{font-size:12px;font-weight:700;color:var(--ink-3)}
.pan-form input{width:100%;height:40px;border-radius:11px;background:var(--soft-bg);padding:0 13px;font-size:14px}
.sk-wrap{display:flex;gap:8px;align-items:center}
.sk-wrap input{flex:1}
.sk-wrap button{height:40px;padding:0 14px;border-radius:11px;background:var(--soft-bg);
  font-size:12.5px;font-weight:700;color:var(--ink-2);flex-shrink:0}
.pan-save{margin:14px 16px 16px;width:calc(100% - 32px);height:44px;border-radius:13px;
  background:var(--pine);color:#fff;font-size:14.5px;font-weight:700}
.pan-guide{padding:6px 16px 10px}
.pan-guide>div{display:flex;gap:12px;align-items:flex-start;padding:9px 0;border-bottom:1px solid var(--line)}
.pan-guide>div:last-child{border-bottom:none}
.pan-guide b{width:23px;height:23px;border-radius:50%;background:var(--pine-soft);color:var(--pine-d);
  font-size:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.pan-guide span{font-size:13px;color:var(--ink-2);line-height:1.55}
/* ============ RAG 知识库检索结果卡片 ============ */
/* RAG：段落引用卡片（左竖线，明显区别于搜索行） */
.ask-card{position:relative;background:var(--paper-card);border-radius:14px;
  padding:13px 15px 11px 16px;margin:0 0 11px 5px;box-shadow:var(--shadow);
  cursor:pointer;border:none;border-left:3px solid var(--pine);transition:transform .15s}
.ask-card:active{transform:scale(.985)}
.ask-card .ac-crumbs{font-size:11.5px;font-weight:700;color:var(--pine-d);margin-bottom:7px;
  display:flex;justify-content:space-between;gap:8px;align-items:center}
.ask-card .ac-score{font-size:11px;color:var(--ink-3);font-weight:600}
.ask-card .ac-text{font-size:14px;line-height:1.72;color:var(--ink);white-space:pre-wrap;
  word-break:break-word}
.ask-card mark{background:#FFE58A;border-radius:3px;padding:0 1px}
.ask-card .ac-loc{margin-top:8px;font-size:11.5px;color:var(--ink-3);display:flex;align-items:center;gap:5px}
.ask-card .ac-open{margin-top:9px;font-size:11.5px;font-weight:700;color:var(--pine);
  display:flex;align-items:center;gap:4px}
/* ===== 统一搜索页 ===== */
.sr-field{flex:1;display:flex;align-items:center;gap:8px;background:var(--soft-bg);
  border-radius:11px;padding:0 11px;height:38px;min-width:0}
.sr-field>svg{width:18px;height:18px;color:var(--ink-3);flex-shrink:0}
.sr-field input{flex:1;border:0;background:transparent;font-size:15px;color:var(--ink-1);
  min-width:0;outline:none}
.sr-field .mini-clear{border:0;background:transparent;color:var(--ink-3);
  padding:2px;flex-shrink:0}
.sr-field .mini-clear:not([hidden]){display:flex}
.sr-field .mini-clear svg{width:16px;height:16px}
.seg{display:flex;gap:4px;margin:10px 14px 2px;background:var(--soft-bg);border-radius:11px;padding:3px}
.seg button{flex:1;height:34px;border:0;border-radius:9px;background:transparent;
  font-size:13.5px;font-weight:700;color:var(--ink-2)}
.seg button.on{background:var(--paper-card);color:var(--pine-d);box-shadow:var(--shadow)}
.sr-body{padding:6px 14px 60px}
.rh-head{display:flex;justify-content:space-between;align-items:center;padding:6px 2px 6px}
.rh-head b{font-size:13px;color:var(--ink-2);font-weight:700}
.rh-head button{border:0;background:transparent;font-size:12px;color:var(--ink-3);font-weight:700}
.hist-row{display:flex;align-items:center;gap:11px;padding:10px 6px;border-bottom:1px solid var(--line)}
.hist-row>svg{width:17px;height:17px;color:var(--ink-3);flex-shrink:0}
.hist-row .hr-q{flex:1;font-size:14.5px;color:var(--ink-1);text-align:left;
  background:transparent;border:0;padding:0;word-break:break-word}
.hist-row .hr-del{border:0;background:transparent;color:var(--ink-3);padding:4px;flex-shrink:0}
.hist-row .hr-del svg{width:15px;height:15px}
.sr-loading{padding:34px 20px;text-align:center;color:var(--ink-3);font-size:13.5px;line-height:1.7}
/* AI：对话气泡（用户靠右、AI 靠左带头像），明显区别于前两种 */
.ai-thread{display:flex;flex-direction:column;gap:12px}
.ai-q-bubble{align-self:flex-end;max-width:85%;background:var(--pine);color:#fff;
  border-radius:18px 18px 5px 18px;padding:10px 14px;font-size:14px;line-height:1.5}
.ai-a-wrap{display:flex;gap:9px;align-items:flex-start}
.ai-avatar{width:30px;height:30px;border-radius:9px;background:rgba(74,107,160,.15);color:#3E609A;
  display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ai-avatar svg{width:18px;height:18px}
.ai-a-bubble{flex:1;min-width:0;background:var(--paper-card);border-radius:5px 18px 18px 18px;
  padding:12px 14px;box-shadow:var(--shadow)}
.ai-a-bubble .aia-txt{font-size:14px;line-height:1.72;color:var(--ink);white-space:pre-wrap;word-break:break-word}
.ai-a-bubble .aia-refs{margin-top:11px;padding-top:10px;border-top:1px solid var(--line)}
.ai-a-bubble .arf-h{font-size:11.5px;font-weight:700;color:var(--ink-3);margin-bottom:5px}
.ai-a-bubble .aia-ref{display:flex;align-items:center;gap:6px;width:100%;text-align:left;
  border-radius:8px;padding:6px 5px;font-size:12.5px;color:var(--pine-d)}
.ai-a-bubble .aia-ref:active{background:var(--soft-bg)}
.ai-a-bubble .aia-ref b{color:var(--pine)}
/* ===== API 配置（ccswitch 风格） ===== */
.ai-list{padding:14px 16px 6px;display:flex;flex-direction:column;gap:11px}
.ai-cfg{background:var(--paper-card);border-radius:15px;padding:13px 15px;box-shadow:var(--shadow);
  border:1px solid transparent}
.ai-cfg.cur{border-color:var(--pine)}
.ai-cfg .ac-top{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:7px}
.ai-cfg .ac-name{font-size:14.5px;font-weight:700;display:flex;align-items:center;gap:7px}
.ai-cfg .ac-curtag{font-size:11px;font-weight:700;color:var(--pine-d)}
.ai-cfg .ac-line{font-size:12px;color:var(--ink-3);line-height:1.6;word-break:break-all}
.ai-cfg .ac-acts{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.ai-cfg .ac-acts button{height:32px;padding:0 13px;border-radius:9px;font-size:12px;font-weight:700;
  background:var(--soft-bg);color:var(--ink-2)}
.ai-cfg .ac-acts button.danger{color:#C0504D}
.ai-cfg .ac-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px}
.ai-cfg .ac-dot.ok{background:#5B8C5A}.ai-cfg .ac-dot.bad{background:#C0504D}
.ai-cfg .ac-dot.none{background:var(--ink-3)}
/* ===== 运行日志 ===== */
.log-filter{display:flex;gap:7px;align-items:center;padding:9px 14px;border-bottom:1px solid var(--line)}
.log-filter button{height:32px;padding:0 14px;border-radius:9px;background:var(--soft-bg);
  font-size:12.5px;font-weight:700;color:var(--ink-2)}
.log-filter button.on{background:var(--pine);color:#fff}
.log-filter button.lc{margin-left:auto;color:#C0504D}
.log-list{padding:8px 14px 50px}
.log-row{display:flex;gap:10px;align-items:flex-start;padding:9px 4px;border-bottom:1px solid var(--line)}
.log-row .lr-lv{width:8px;height:8px;border-radius:50%;margin-top:6px;flex-shrink:0}
.log-row .lr-lv.error{background:#C0504D}.log-row .lr-lv.warn{background:#D9A441}
.log-row .lr-lv.info{background:#8AA68A}
.log-row .lr-body{flex:1;min-width:0}
.log-row .lr-meta{display:flex;gap:8px;align-items:center;margin-bottom:2px;flex-wrap:wrap}
.log-row .lr-t{font-size:11px;color:var(--ink-3)}
.log-row .lr-cat{font-size:11px;font-weight:700;color:var(--pine-d);background:var(--pine-soft);
  padding:1px 7px;border-radius:6px}
.log-row .lr-msg{font-size:13px;color:var(--ink-1);line-height:1.5;word-break:break-word}
.log-row .lr-detail{margin-top:5px;font-size:12px;color:var(--ink-2);background:var(--soft-bg);
  border-radius:8px;padding:7px 9px;white-space:pre-wrap;word-break:break-word;display:none}
.log-row.open .lr-detail{display:block}
.log-empty{padding:40px 20px;text-align:center;color:var(--ink-3);font-size:13.5px}
/* ============ 同步进度遮罩 ============ */
.sync-overlay{position:fixed;inset:0;background:rgba(30,32,28,.45);display:none;
  align-items:center;justify-content:center;z-index:220;backdrop-filter:blur(2px)}
.sync-overlay.show{display:flex}
.sync-card{width:252px;background:var(--card);border-radius:20px;padding:26px 22px;
  display:flex;flex-direction:column;align-items:center;gap:7px;text-align:center;
  box-shadow:0 18px 50px rgba(0,0,0,.25)}
#syncTopBar{position:fixed;top:0;left:0;right:0;height:3px;z-index:120;pointer-events:none;
  opacity:0;transition:opacity .25s}
#syncTopBar.show{opacity:1}
#syncTopBar i{display:block;height:100%;width:40%;
  background:linear-gradient(90deg,transparent,var(--pine),transparent);
  animation:syncslide 1.1s linear infinite}
@keyframes syncslide{0%{transform:translateX(-120%)}100%{transform:translateX(360%)}}
@media (prefers-reduced-motion:reduce){#syncTopBar i{animation:none;width:100%}}
.sync-ring{width:86px;height:86px;border-radius:50%;margin-bottom:8px;
  background:conic-gradient(var(--pine) var(--p,0%),var(--soft-bg) 0);
  display:flex;align-items:center;justify-content:center}
.sync-ring span{width:68px;height:68px;border-radius:50%;background:var(--card);
  display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px}
.sync-card b{font-size:16px;font-weight:800}
.sync-card #syncMsg{font-size:13px;color:var(--ink-2);line-height:1.5;min-height:20px}
@media(max-width:519px){
  .search-entry input,.todo-edit-row input,.modal-input,.pan-form input{font-size:16px}
}

/* ============ 笔记本选择面板（移动便签） ============ */
.nb-picker{position:absolute;inset:0;z-index:120;background:#eef0f3;
  display:none;flex-direction:column;color:#1c1f1b;
  transform:translateX(100%);transition:transform .28s cubic-bezier(.32,.72,.24,1)}
.nb-picker.open{display:flex}
.nb-picker.open.show{transform:translateX(0)}
.nbp-top{display:flex;align-items:center;gap:6px;flex-shrink:0;
  padding:max(10px,calc(env(safe-area-inset-top,0px) + 6px)) 12px 4px}
.nbp-title{font-size:19px;font-weight:800;flex:1;text-align:left;padding-left:4px}
.nbp-scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:6px 16px 30px}
.nbp-all{display:flex;align-items:center;gap:14px;width:100%;
  background:#e2e4e8;border-radius:18px;padding:17px 18px;margin-bottom:20px}
.nbp-all-ico{width:28px;height:28px;color:#3a3f38;display:flex;flex-shrink:0}
.nbp-name{flex:1;text-align:left;font-size:19px;font-weight:800}
.nbp-count{font-size:18px;color:#8a8f8a;font-weight:500}
.nbp-manage{width:34px;height:34px;color:#98a098;display:flex;flex-shrink:0;
  align-items:center;justify-content:center;border-radius:9px;margin-right:-6px}
.nbp-manage:active{background:rgba(0,0,0,.07)}
.nbp-manage svg{width:20px;height:20px;pointer-events:none}
.nbp-section{display:flex;align-items:center;justify-content:space-between;
  padding:2px 6px 12px}
.nbp-sec-label{font-size:17px;font-weight:800}
.nbp-new{font-size:16px;font-weight:700;color:#d99a12}
.nbp-card{background:#fff;border-radius:20px;overflow:hidden}
.nbp-row{display:flex;align-items:center;gap:14px;width:100%;padding:15px 18px;position:relative}
.nbp-row+.nbp-row::before{content:'';position:absolute;top:0;left:64px;right:18px;height:1px;background:#f1f2ef}
.nbp-folder{width:38px;height:38px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
  border-radius:11px;background:color-mix(in srgb,currentColor 13%,transparent)}
.nbp-folder svg{width:22px;height:22px}
.nbp-row .nbp-name{font-size:18px;font-weight:700}
.nbp-cur{width:24px;height:24px;color:#2f8f5b;flex-shrink:0;display:none}
.nbp-row.iscur .nbp-cur{display:flex}
.nbp-empty{padding:26px 18px;font-size:14px;color:#9aa09a;text-align:center}

/* ============ 编辑页 v4（白纸极简） ============ */
#scr-edit{background:var(--paper)}
:root[data-theme="dark"] #scr-edit{background:var(--paper)}
.edit-top{display:flex;align-items:center;gap:6px;flex-shrink:0;position:relative;
  padding:max(9px,calc(env(safe-area-inset-top,0px) + 5px)) 22px 4px}
.et-group{display:flex;align-items:center;gap:6px;min-width:0}
.et-left{flex:0 0 auto;justify-content:flex-start;padding-left:10px}
.et-center{position:absolute;left:50%;transform:translateX(-50%)}
.et-right{flex:1 1 auto;justify-content:flex-end;min-width:0;padding-right:10px}
.et-group .icon-btn{flex-shrink:0}
#editShare{display:none}
.paper-scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;
  will-change:scroll-position;
  padding:6px 22px 30px}
/* 常驻格式栏展开时，内容可滚到工具条上方，不被永久遮挡 */
body.rt-manual .paper-scroll{padding-bottom:96px}
.paper-meta{font-size:12.5px;color:#9aa096;padding:8px 2px 14px}
:root[data-theme="dark"] .paper-meta{color:var(--ink-3)}
.paper-title{width:100%;font-size:28px;font-weight:900;padding:2px 0 16px;line-height:1.3;color:#161815}
.paper-title::placeholder{color:#c6cac2;font-weight:900}
:root[data-theme="dark"] .paper-title{color:var(--ink)}
:root[data-theme="dark"] .paper-title::placeholder{color:#4a4f47}
.paper-rtbar{position:fixed;top:0;left:0;display:flex;align-items:center;gap:2px;
  background:#ffffff;border:1px solid rgba(20,24,18,.08);border-radius:14px;
  padding:5px 6px;box-shadow:0 10px 30px rgba(28,34,24,.18);z-index:80;
  opacity:0;visibility:hidden;pointer-events:none;
  transform:translateY(-8px) scale(.97);transform-origin:center bottom;
  transition:opacity .15s ease,transform .15s ease,visibility .15s ease}
.paper-rtbar.show{opacity:1;visibility:visible;pointer-events:auto;transform:translateY(0) scale(1)}
:root[data-theme="dark"] .paper-rtbar{background:#272a24;border-color:rgba(255,255,255,.09);box-shadow:0 10px 30px rgba(0,0,0,.5)}
.pr-btn{width:36px;height:35px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#434a40;font-weight:800}
.pr-btn svg{width:17px;height:17px}
.pr-btn:active,.pr-btn.on{background:#1b1e1a;color:#fff}
.pr-btn.disabled{opacity:.32;pointer-events:none}
.icon-btn.disabled{opacity:.3;pointer-events:none}
:root[data-theme="dark"] .pr-btn{color:#cfd4c9}
:root[data-theme="dark"] .pr-btn.on{background:#eef0e8;color:#1b1e1a}
.pr-sep{width:1px;height:18px;background:rgba(0,0,0,.12);margin:0 4px}
:root[data-theme="dark"] .pr-sep{background:rgba(255,255,255,.16)}
.pr-size{font-size:12px;font-weight:800;min-width:15px;text-align:center;color:#434a40}
:root[data-theme="dark"] .pr-size{color:#cfd4c9}
.paper-body{min-height:300px;font-size:17px;line-height:1.8;padding:8px 0;word-break:break-word;
  color:#1d201c;border:none;outline:none;-webkit-tap-highlight-color:transparent}
.paper-body:focus{outline:none;border:none}
.paper-body:empty::before{content:attr(data-ph);color:#bfc4bb}
:root[data-theme="dark"] .paper-body{color:var(--ink)}
.paper-body b,.paper-body strong{font-weight:800}
.paper-body u{text-decoration:underline;text-underline-offset:3px}
.paper-body mark,.paper-body .hl{background:#ffe27a;border-radius:3px;padding:0 2px;color:inherit}
.paper-body img.note-img{max-width:100%;border-radius:12px;margin:10px 0;display:block}
/* 内联附件位置标记（原子芯片，冷灰+琥珀金） */
.attref{display:inline-flex;align-items:center;gap:6px;max-width:100%;
  margin:2px 3px;padding:4px 10px;border-radius:10px;vertical-align:middle;
  background:color-mix(in srgb,var(--pine) 14%,var(--card));
  border:1px solid color-mix(in srgb,var(--pine) 38%,transparent);
  color:var(--pine);font-size:13px;font-weight:600;line-height:1.4;
  user-select:none;cursor:default;transition:transform .12s ease,background .15s ease}
.attref svg{width:14px;height:14px;flex:none}
.attref .ar-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text)}
.attref .ar-idx{flex:none;font-size:11px;font-weight:800;opacity:.75}
.attref:active{transform:scale(.96)}
font[size="1"]{font-size:13px}font[size="2"]{font-size:15px}font[size="3"]{font-size:17px}
font[size="4"]{font-size:19.5px}font[size="5"]{font-size:22px}font[size="6"]{font-size:25px}font[size="7"]{font-size:28px}
.paper-todo{display:none}
.paper-todo.show{display:block;padding:6px 0}
.pt-row{display:flex;align-items:flex-start;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);touch-action:none}
.pt-row .tc{width:25px;height:25px;border-radius:50%;border:2px solid #b9bdb4;flex-shrink:0;margin-top:2px;
  display:flex;align-items:center;justify-content:center;touch-action:manipulation}
.pt-row .tc.done{background:var(--pine);border-color:var(--pine)}
.pt-row .tc svg{width:14px;height:14px;color:#fff;opacity:0}
.pt-row .tc.done svg{opacity:1;animation:pop .26s cubic-bezier(.34,1.56,.64,1)}
.pt-row textarea.pt-text{flex:1;font-size:16.5px;min-width:0;touch-action:manipulation;
  resize:none;overflow:hidden;background:transparent;border:none;outline:none;line-height:1.5;
  padding:2px 0;font-family:inherit;white-space:pre-wrap;word-break:break-word;display:block}
.pt-row textarea.pt-text.done{text-decoration:line-through;color:#a9ada5}
.pt-row .pri{width:28px;height:28px;flex-shrink:0;display:flex;align-items:center;justify-content:center;touch-action:manipulation}
.pt-row .pri svg{width:18px;height:18px}
.pt-row .rd{width:27px;height:27px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#b9bdb4}
.pt-row .rd svg{width:17px;height:17px}
.pt-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:4px}
.pt-addrow{display:flex;align-items:center;gap:9px;padding:11px 0;color:var(--pine);font-weight:700;font-size:15px}
.pt-addrow svg{width:20px;height:20px}
.pt-progtoggle{width:38px;height:38px;border-radius:50%;background:var(--soft-bg);
  display:flex;align-items:center;justify-content:center;color:var(--ink-2);flex-shrink:0}
.pt-progtoggle svg{width:20px;height:20px}
.pt-foot-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
.pt-posttoggle{width:38px;height:38px;border-radius:50%;background:var(--soft-bg);
  display:flex;align-items:center;justify-content:center;color:var(--ink-2);flex-shrink:0}
.pt-posttoggle svg{width:19px;height:19px}
.pt-posttoggle:active{background:var(--line)}
.pt-progress{display:flex;align-items:center;gap:12px;margin:4px 0 8px}
.pt-progress .bar{flex:1;height:7px;border-radius:4px;background:var(--bar-track);overflow:hidden}
.pt-progress .bar i{display:block;height:100%;background:var(--pine)}
.pt-progress .pct{font-size:13px;font-weight:700;color:var(--pine);min-width:72px;text-align:right}
.pt-row.lift{position:fixed;z-index:15;background:#fff;border-radius:12px;
  box-shadow:var(--shadow-lg);border-bottom:none;padding:10px 12px}
:root[data-theme="dark"] .pt-row.lift{background:var(--paper-card)}
.pt-ghost{background:var(--pine-soft);border-radius:10px;border-bottom:none}
.paper-attach{display:flex;flex-direction:column;gap:10px;margin:14px 0 4px}
.pa-card{display:flex;align-items:center;gap:14px;padding:16px;border-radius:18px;
  background:#f3f5f1;width:100%;text-align:left}
:root[data-theme="dark"] .pa-card{background:var(--soft-bg)}
.pa-idx{font-size:12px;font-weight:800;color:var(--ink-2);min-width:24px;text-align:center;
  background:var(--soft-bg);border-radius:8px;padding:6px 0;align-self:center}
.pa-txt{flex:1;min-width:0;cursor:pointer}
.pa-txt b{display:block;font-size:17px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pa-txt small{display:block;font-size:12.5px;color:#9aa096;margin-top:5px}
.pa-ico{width:58px;height:58px;border-radius:15px;flex-shrink:0;cursor:pointer;
  display:flex;align-items:center;justify-content:center;overflow:hidden}
.pa-ico svg{width:42px;height:42px;color:#fff}
.pa-del{width:28px;height:28px;flex-shrink:0;align-self:flex-start;
  display:flex;align-items:center;justify-content:center;color:#b9bdb4}
.pa-del svg{width:16px;height:16px}
.pa-md{align-self:center;flex-shrink:0;font-size:10px;font-weight:800;color:var(--pine);
  background:transparent;border:1.5px solid var(--pine);border-radius:9px;padding:4px 5px;line-height:1}
.pa-md:active{background:var(--pine);color:#fff}
.pa-ocr{align-self:center;flex-shrink:0;font-size:10px;font-weight:800;color:#fff;
  background:var(--pine);border:1.5px solid var(--pine);border-radius:9px;padding:4px 6px;line-height:1}
.pa-ocr:active{background:var(--pine-d);border-color:var(--pine-d)}
#imgBar{position:fixed;display:none;gap:4px;background:#1d201c;border-radius:13px;
  padding:5px;z-index:200;box-shadow:var(--shadow)}
#imgBar button{border:0;background:transparent;color:#fff;font-size:13px;font-weight:700;
  border-radius:9px;padding:7px 13px}
#imgBar button:active{background:rgba(255,255,255,.18)}
#imgBar #imgBarDel{color:#ff9a8f}

/* ============ 底部胶囊工具栏 ============ */
.dock{position:static;transform:none;flex-shrink:0;z-index:30;display:flex;
  align-items:center;justify-content:center;gap:6px;
  background:var(--paper-card);border-top:1px solid var(--line);
  border-radius:0;padding:8px 8px calc(8px + var(--safe-b))}
:root[data-theme="dark"] .dock{background:var(--paper-card)}
.dock-btn{position:relative;width:52px;height:46px;border-radius:16px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;color:#3a3f39;transition:background .15s}
:root[data-theme="dark"] .dock-btn{color:var(--ink)}
.dock-btn svg{width:25px;height:25px}
.dock-btn:active{background:rgba(0,0,0,.07)}
:root[data-theme="dark"] .dock-btn:active{background:rgba(255,255,255,.1)}
.dock-btn.on{color:var(--pine)}

/* 导出快照状态：隐藏工具栏、强制白纸 */
body.capturing .dock,body.capturing .edit-top{display:none!important}
body.capturing #scr-edit{background:#fff!important}
body.capturing .paper-scroll{padding:34px 26px 40px}
body.capturing .paper-meta{color:#9aa096!important}
body.capturing .paper-title{color:#161815!important}
body.capturing .paper-body{color:#1d201c!important}
body.capturing .pa-card{background:#f3f5f1!important}
body.capturing .pa-txt small{color:#9aa096!important}
body.capturing .paper-rtbar{display:none!important}

/* ============================================================
   桌面端（Electron）三栏布局 —— 仅 html.platform-desktop 生效
   ============================================================ */
.platform-desktop body{background:var(--paper);padding:0;display:block;overflow:hidden}
.platform-desktop .phone{max-width:none;height:100vh;border-radius:0;box-shadow:none}
.platform-desktop .app{display:grid;grid-template-columns:228px 308px minmax(0,1fr)}

/* 左栏 */
#deskSidebar{grid-column:1;display:flex;flex-direction:column;min-height:0;
  background:var(--paper-card);border-right:1px solid var(--line);padding:14px 12px}
.desk-logo{display:flex;align-items:center;gap:9px;padding:4px 8px 12px}
.desk-logo .dl-ico{width:30px;height:30px;border-radius:9px;background:var(--pine);
  display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}
.desk-logo .dl-ico svg{width:18px;height:18px}
.desk-logo b{font-size:17px;font-weight:800;letter-spacing:.5px}
.desk-group-t{font-size:11px;font-weight:700;color:var(--ink-3);letter-spacing:1px;padding:10px 10px 5px}
.desk-item{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;border-radius:10px;
  color:var(--ink-2);font-size:14px;font-weight:500;text-align:left}
.desk-item svg{width:18px;height:18px;flex-shrink:0}
.desk-item:hover{background:var(--soft-bg);color:var(--ink)}
.desk-item.on{background:var(--pine-soft);color:var(--pine-d);font-weight:700}
.desk-item .n{margin-left:auto;font-size:12px;color:var(--ink-3)}
.desk-item.on .n{color:var(--pine-d)}
.desk-scroll{flex:1;overflow-y:auto;min-height:0;margin:0 -4px;padding:0 4px}
.desk-new{margin-top:10px;width:100%;padding:11px;border-radius:12px;background:var(--pine);color:#fff;
  font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:7px;
  box-shadow:0 4px 12px rgba(180,140,20,.3)}
.desk-new svg{width:17px;height:17px}
.desk-new:hover{background:var(--pine-d)}

/* home / edit 作中、右栏常驻 */
.platform-desktop #scr-home{grid-column:2;position:relative;inset:auto;
  visibility:visible;opacity:1;pointer-events:auto;display:flex;
  border-right:1px solid var(--line);background:var(--paper)}
.platform-desktop #scr-edit{grid-column:3;position:relative;inset:auto;
  visibility:visible;opacity:1;pointer-events:auto;display:flex;background:var(--paper)}
.platform-desktop .screen:not(#scr-home):not(#scr-edit){position:absolute;inset:0;z-index:60}

/* 中栏顶栏 / 列表 */
.platform-desktop #homeTopbar{padding:12px 14px;gap:8px}
.platform-desktop #openChat,.platform-desktop #openSettings,.platform-desktop #searchCancel{display:none}
.platform-desktop .search-entry{flex:1}
.platform-desktop #homeSearch{cursor:text}
.platform-desktop #chipsRow{display:none}
.platform-desktop #fab{display:none!important}
.platform-desktop #scr-home .screen-body{padding:6px 10px 14px}
.platform-desktop .note-card{margin:0 0 6px;padding:12px 13px;border-radius:12px;cursor:pointer;
  box-shadow:none;border:1px solid var(--line);background:var(--paper-card)}
.platform-desktop .note-card:hover{border-color:var(--pine);transform:none}
.platform-desktop .note-card.current{border-color:var(--pine);background:var(--pine-soft);
  box-shadow:inset 3px 0 0 var(--pine)}
.platform-desktop #contextBar{padding:10px 14px}
.platform-desktop #batchBar{position:static;transform:none;margin:8px 10px;
  background:var(--paper-card);border:1px solid var(--line);border-radius:12px;padding:8px}
.platform-desktop #scr-home:not(.select-mode) #contextBar,
.platform-desktop #scr-home:not(.select-mode) #batchBar{display:none}

/* 右栏顶栏 / 编辑区 */
.platform-desktop #editTop{padding:12px 18px;order:-1}
.platform-desktop #editBack,.platform-desktop .et-left{display:none}
.platform-desktop .et-center{position:static;transform:none;left:auto}
.platform-desktop .et-center .icon-btn,.platform-desktop .et-right .icon-btn{
  background:none;box-shadow:none;width:36px;height:36px}
.platform-desktop .et-center .icon-btn:hover,.platform-desktop .et-right .icon-btn:hover{background:var(--soft-bg)}
.platform-desktop .et-right{margin-left:auto}
.platform-desktop .paper-scroll{padding:16px 36px 80px;max-width:880px;width:100%;margin:0 auto;order:1}
.platform-desktop .paper-title{font-size:30px}
/* dock 重排为编辑区下方的第二行工具条（editTop 之后、正文之前） */
.platform-desktop #dock{order:0;position:static;background:none;border:none;padding:4px 36px 0;
  display:flex;gap:6px;justify-content:flex-start;max-width:880px;margin:0 auto;width:100%}
.platform-desktop .dock-btn{width:34px;height:34px;background:none;box-shadow:none;border:1px solid transparent}
.platform-desktop .dock-btn:hover{background:var(--soft-bg)}

/* 右栏空状态 */
#deskEditEmpty{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;
  justify-content:center;gap:14px;color:var(--ink-3);text-align:center;padding:20px}
#deskEditEmpty .de-ico{width:56px;height:56px;opacity:.5}
#deskEditEmpty p{font-size:15px;line-height:1.7;max-width:320px}
.platform-desktop #app.desk-empty #deskEditEmpty{display:flex}
.platform-desktop #app.desk-empty #paperScroll,.platform-desktop #app.desk-empty #dock,
.platform-desktop #app.desk-empty #editTop{display:none}
#deskEditEmpty .desk-empty-new{padding:10px 22px;border-radius:11px;background:var(--pine);color:#fff;
  font-weight:700;font-size:14px}
#deskEditEmpty .desk-empty-new:hover{background:var(--pine-d)}

/* 覆盖层（设置/回收站/网盘等）宽屏内容居中 */
.platform-desktop .screen:not(#scr-home):not(#scr-edit) .topbar{
  align-self:center;width:100%;max-width:920px}
.platform-desktop .screen:not(#scr-home):not(#scr-edit) .screen-body{
  display:flex;justify-content:center}
.platform-desktop .screen:not(#scr-home):not(#scr-edit) .screen-body>*{
  width:100%;max-width:880px}
/* 仅桌面显示的控件（如 AI 对话返回键） */
.desk-only{display:none}
.platform-desktop .desk-only{display:inline-flex;align-items:center;justify-content:center}
</style>
</head>
<body>
<div class="phone">
  <div class="app" id="app">

    <!-- ===== 视图：首页 ===== -->
    <section class="screen root active" id="scr-home">
      <header class="topbar" id="homeTopbar">
        <button class="icon-btn ai-entry" id="openChat" aria-label="AI 对话">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.6l1.9 5.1 5.1 1.9-5.1 1.9L12 16.6l-1.9-5.1L5 9.6l5.1-1.9z"/><path d="M18.6 15l.85 2.35L21.8 18.2l-2.35.85L18.6 21.4l-.85-2.35L15.4 18.2l2.35-.85z" opacity=".65"/></svg>
        </button>
        <div class="search-entry">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="homeSearch" placeholder="搜索" autocomplete="off" readonly>
          <button class="mini-clear" id="miniClear" hidden aria-label="清空">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <button class="icon-btn" id="openSettings" aria-label="设置">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
        <button class="cancel-link" id="searchCancel">取消</button>
      </header>
      <header class="context-bar" id="contextBar">
        <button class="icon-btn" id="exitSelect" aria-label="退出多选">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
        <span class="count" id="selCount">已选 0 项</span>
        <button class="icon-btn" id="selectAll" aria-label="全选">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
        </button>
      </header>
      <div class="chips-row" id="chipsRow"></div>
      <div class="screen-body">
        <div class="notes-wrap" id="notesWrap"></div>
      </div>
      <div class="batch-bar" id="batchBar">
        <button class="bb-btn" id="bbMove"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.7-.9L9.3 3.6A2 2 0 0 0 7.6 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z"/></svg>移动</button>
        <button class="bb-btn" id="bbPin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6l-1 7 3 3H7l3-3z"/><path d="M12 13v8"/></svg>置顶</button>
        <button class="bb-btn" id="bbColor"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18c.9 0 1.6-.7 1.6-1.6 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.1 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-3.9-4-7.5-9-7.5z"/><circle cx="7.5" cy="10.5" r="1.1" fill="currentColor"/><circle cx="12" cy="7.5" r="1.1" fill="currentColor"/><circle cx="16.5" cy="10.5" r="1.1" fill="currentColor"/></svg>颜色</button>
        <button class="bb-btn" id="bbDelete"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></svg>删除</button>
      </div>
      <button class="fab" id="fab" aria-label="新建">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      </button>
    </section>

    <!-- ===== 视图：编辑 ===== -->
    <section class="screen" id="scr-edit">
      <header class="edit-top" id="editTop">
        <div class="et-group et-left">
        <button class="icon-btn" id="editBack" aria-label="返回">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </button>
        </div>
        <div class="et-group et-center">
        <button class="icon-btn disabled" id="editUndo" aria-label="撤销">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg>
        </button>
        <button class="icon-btn disabled" id="editRedo" aria-label="重做">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 14 5-5-5-5"/><path d="M20 9H10a6 6 0 0 0 0 12h3"/></svg>
        </button>
        </div>
        <div class="et-group et-right">
        <button class="icon-btn note-ai-btn" id="editNoteAI" aria-label="本页智能问答">AI</button>
        <button class="icon-btn" id="editShare" aria-label="分享">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
        </button>
        <button class="icon-btn" id="editMore" aria-label="更多">
          <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="12" cy="19" r="1.9"/></svg>
        </button>
        </div>
      </header>
      <div class="paper-scroll" id="paperScroll">
        <div class="paper-meta" id="paperMeta"></div>
        <input class="paper-title" id="paperTitle" placeholder="标题" maxlength="40">
        <div class="paper-rtbar" id="paperRtBar"></div>
        <div class="paper-todo" id="paperTodo"></div>
        <div class="paper-body" id="paperBody" contenteditable="true" spellcheck="false"></div>
        <div class="paper-attach" id="paperAttach"></div>
      </div>
      <div class="dock" id="dock">
        <button class="dock-btn" id="dockAI" aria-label="格式笔">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </button>
        <button class="dock-btn" id="dockTodo" aria-label="待办">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.6 2.6L16 9"/></svg>
        </button>
        <button class="dock-btn" id="dockAdd" aria-label="插入">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9.2"/><path d="M12 8.2v7.6M8.2 12h7.6"/></svg>
        </button>
      </div>
      <div id="deskEditEmpty">
        <svg class="de-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/><path d="M9 13h6M9 17h4"/></svg>
        <p>从左侧选择一条便签查看与编辑，<br>或点击按钮新建一张便签。</p>
        <button class="desk-empty-new" id="deskEmptyNew">+ 新建便签</button>
      </div>
    </section>
    <!-- ===== 视图：回收站 ===== -->
    <section class="screen" id="scr-trash">
      <header class="topbar">
        <button class="icon-btn" id="trashBack" aria-label="返回">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
